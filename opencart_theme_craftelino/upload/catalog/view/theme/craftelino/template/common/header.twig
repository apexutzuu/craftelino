<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <script src="{{ jquery }}" type="text/javascript"></script>
  <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link href="{{ craftelino_css }}" type="text/css" rel="stylesheet"/>
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  <script src="{{ craftelino_js }}" type="text/javascript" defer></script>
  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="{{ icon }}"/>
  {% endif %}
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="{{ name }}"/>
  <meta property="og:title" content="{{ title }}"/>
  {% if description %}
    <meta property="og:description" content="{{ description }}"/>
  {% endif %}
  <meta property="og:url" content="{{ og_url }}"/>
  {% if og_image %}
    <meta property="og:image" content="{{ og_image }}"/>
  {% endif %}
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="{{ title }}"/>
  {% if description %}
    <meta name="twitter:description" content="{{ description }}"/>
  {% endif %}
  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
  {% if schema_markup %}
    <script type="application/ld+json">{{ schema_markup|raw }}</script>
  {% endif %}
</head>
<body class="craftelino-shop">
<div id="container">
  <div id="alert"></div>

  <h2 class="visually-hidden">{{ title }}</h2>

  <div class="craft-topbar">
    <div class="container">
      <a class="craft-topbar-promo" href="{{ link_personalizare }}">Personalizare logo GRATUITĂ la comenzi peste 500 lei</a>
      <div class="craft-topbar-meta">
        <div class="craft-topbar-links">
          <a href="{{ link_catalog }}">Catalog</a>
          <a href="{{ link_quote }}">Cerere ofertă</a>
          <a href="{% if logged %}{{ account }}{% else %}{{ login }}{% endif %}">Cont firmă</a>
        </div>
        <ul class="list-inline mb-0">
          <li class="list-inline-item me-2">{{ currency }}</li>
          <li class="list-inline-item">{{ language }}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="craft-header">
    <div class="container">
      <div id="logo" class="craft-logo">
        <a href="{{ home }}" class="craft-logo-link" title="{{ name }}">
          {% if logo %}
            <img src="{{ logo }}" alt="{{ name }}" width="200" height="40" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/>
            <span class="craft-logo-text" style="display:none">CRAFT<span>ELINO</span></span>
          {% else %}
            <span class="craft-logo-text">CRAFT<span>ELINO</span></span>
          {% endif %}
        </a>
      </div>
      <div class="craft-search-wrap">{{ search }}</div>
      <div class="craft-header-actions">
        <a class="craft-hbtn" href="{{ login }}" title="B2B"><i class="fa-solid fa-building"></i><span>B2B</span></a>
        <a class="craft-hbtn" href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}"><i class="fa-solid fa-heart"></i><span>Favorite</span></a>
        <div id="cart" class="craft-cart-slot">{{ cart }}</div>
        <div class="dropdown">
          <button type="button" class="craft-hbtn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true" aria-label="{{ text_account }} — meniu"><i class="fa-solid fa-user" aria-hidden="true"></i><span>{{ text_account }}</span></button>
          <ul class="dropdown-menu dropdown-menu-end">
            {% if not logged %}
              <li><a href="{{ register }}" class="dropdown-item">{{ text_register }}</a></li>
              <li><a href="{{ login }}" class="dropdown-item">{{ text_login }}</a></li>
            {% else %}
              <li><a href="{{ account }}" class="dropdown-item">{{ text_account }}</a></li>
              <li><a href="{{ order }}" class="dropdown-item">{{ text_order }}</a></li>
              <li><a href="{{ transaction }}" class="dropdown-item">{{ text_transaction }}</a></li>
              <li><a href="{{ download }}" class="dropdown-item">{{ text_download }}</a></li>
              <li><a href="{{ logout }}" class="dropdown-item">{{ text_logout }}</a></li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <nav class="craft-nav">
    <div class="container align-items-stretch">
      {{ menu }}
    </div>
  </nav>

  <main>
