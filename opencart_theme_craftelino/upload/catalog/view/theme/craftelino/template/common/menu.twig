{% if categories %}
  <div class="dropdown align-self-stretch">
    <button type="button" class="craft-nav-all dropdown-toggle h-100 border-0 rounded-0" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-bars"></i> Toate produsele</button>
    <div class="dropdown-menu shadow border-0 rounded-0 p-0" style="min-width: 280px;">
      <ul class="list-unstyled mb-0 py-2">
        {% for category in categories %}
          <li class="px-3 py-1">
            {% if category.children %}
              <div class="fw-bold text-uppercase small text-muted mb-1">{{ category.name }}</div>
              <ul class="list-unstyled ms-2 mb-2">
                {% for child in category.children %}
                  <li><a href="{{ child.href }}" class="dropdown-item px-0 py-1">{{ child.name }}</a></li>
                {% endfor %}
              </ul>
              <a href="{{ category.href }}" class="small d-block mb-2">{{ text_all }} {{ category.name }}</a>
            {% else %}
              <a href="{{ category.href }}" class="dropdown-item">{{ category.name }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="craft-nav-links flex-grow-1">
    <a href="{{ special }}" class="craft-hot">⭐ Bestsellers</a>
    {% for category in categories|slice(0, 9) %}
      <a href="{{ category.href }}">{{ category.name }}</a>
    {% endfor %}
  </div>
{% endif %}
