<form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart">
  <div class="product-thumb craft-card">
    <div class="craft-card-img">
      <a href="{{ href }}"><img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" class="img-fluid"/></a>
      {% if discount_percent > 0 %}
        <span class="craft-badge-sale">-{{ discount_percent }}%</span>
      {% elseif special %}
        <span class="craft-badge-sale">{{ text_sale_badge }}</span>
      {% elseif badge_new %}
        <span class="craft-badge-new">NOU</span>
      {% endif %}
      <button type="submit" class="craft-wish" formaction="{{ wishlist_add }}" data-bs-toggle="tooltip" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}"><i class="fa-solid fa-heart"></i></button>
    </div>
    <div class="craft-card-body">
      {% if manufacturer_name %}
        <div class="craft-brand">{{ manufacturer_name }}</div>
      {% else %}
        <div class="craft-brand" aria-hidden="true">&nbsp;</div>
      {% endif %}
      <div class="description">
        <h4><a href="{{ href }}">{{ name }}</a></h4>
        <p>{{ description }}</p>
        {% if price %}
          <div class="price">
            {% if not special %}
              <span class="price-new">{{ price }}</span>
            {% else %}
              <span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
            {% endif %}
            {% if tax %}
              <span class="price-tax">{{ text_tax }} {{ tax }}</span>
            {% endif %}
          </div>
        {% endif %}
        {% if review_status and rating %}
          <div class="rating">
            {% for i in 1..5 %}
              {% if rating < i %}
                <span class="fa-stack"><i class="fa-regular fa-star fa-stack-1x"></i></span>
              {% else %}
                <span class="fa-stack"><i class="fa-solid fa-star fa-stack-1x"></i><i class="fa-regular fa-star fa-stack-1x"></i></span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="button">
        <button type="submit" formaction="{{ cart_add }}" data-bs-toggle="tooltip" title="{{ button_cart }}"><i class="fa-solid fa-cart-shopping"></i> {{ button_add }}</button>
        <button type="submit" formaction="{{ wishlist_add }}" data-bs-toggle="tooltip" title="{{ button_wishlist }}"><i class="fa-solid fa-heart"></i></button>
        <button type="submit" formaction="{{ compare_add }}" data-bs-toggle="tooltip" title="{{ button_compare }}"><i class="fa-solid fa-arrow-right-arrow-left"></i></button>
      </div>
      <input type="hidden" name="product_id" value="{{ product_id }}"/> <input type="hidden" name="quantity" value="{{ minimum }}"/>
    </div>
  </div>
</form>
