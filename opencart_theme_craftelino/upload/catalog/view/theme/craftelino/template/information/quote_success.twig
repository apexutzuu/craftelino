{{ header }}
<div class="container craft-quote-page py-4">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <div class="craft-quote-success">
        <h1>{{ heading_title }}</h1>
        <p>{{ text_message }}</p>
        <a href="{{ continue }}" class="btn craft-hero-cta">{{ button_continue }}</a>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
