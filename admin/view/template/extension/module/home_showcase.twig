{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_sections }}">{{ entry_sections }}</span></label>
            <div class="col-sm-10">
              <p class="help-block">{{ help_sections }}</p>
              <table class="table table-bordered" id="home-showcase-table">
                <thead>
                  <tr>
                    <td style="width:70px;">{{ entry_enabled }}</td>
                    <td style="width:200px;">{{ entry_source }}</td>
                    <td>{{ entry_category }}</td>
                    <td>{{ entry_heading }}</td>
                    <td style="width:90px;">{{ entry_limit }}</td>
                    <td style="width:50px;"></td>
                  </tr>
                </thead>
                <tbody id="home-showcase-rows">
                  {% for section in sections %}
                  <tr class="home-showcase-row">
                    <td class="text-center">
                      <input type="checkbox" name="section[{{ loop.index0 }}][enabled]" value="1" {% if section.enabled %}checked="checked"{% endif %} />
                    </td>
                    <td>
                      <select name="section[{{ loop.index0 }}][source]" class="form-control input-source">
                        {% for opt in source_options %}
                        <option value="{{ opt.value }}" {% if section.source == opt.value %}selected="selected"{% endif %}>{{ opt.label }}</option>
                        {% endfor %}
                      </select>
                    </td>
                    <td>
                      <select name="section[{{ loop.index0 }}][category_id]" class="form-control input-category" {% if section.source != 'category' %}disabled="disabled"{% endif %}>
                        <option value="0">—</option>
                        {% for c in category_options %}
                        <option value="{{ c.category_id }}" {% if section.category_id == c.category_id %}selected="selected"{% endif %}>{{ c.name }}</option>
                        {% endfor %}
                      </select>
                    </td>
                    <td>
                      <input type="text" name="section[{{ loop.index0 }}][heading]" value="{{ section.heading }}" class="form-control" placeholder="{{ entry_heading }}" />
                    </td>
                    <td>
                      <input type="number" name="section[{{ loop.index0 }}][limit]" value="{{ section.limit }}" min="1" max="50" class="form-control" />
                    </td>
                    <td class="text-center">
                      <button type="button" class="btn btn-danger btn-xs btn-remove-row" title="Remove"><i class="fa fa-minus-circle"></i></button>
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
              <button type="button" id="btn-add-row" class="btn btn-default"><i class="fa fa-plus-circle"></i> {{ button_add_row }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
function showcaseReindexRows() {
  $('#home-showcase-rows tr.home-showcase-row').each(function(i) {
    $(this).find('input,select').each(function() {
      var n = $(this).attr('name');
      if (n) {
        $(this).attr('name', n.replace(/section\[\d+\]/, 'section[' + i + ']'));
      }
    });
  });
}

function showcaseToggleCategory($row) {
  var src = $row.find('select.input-source').val();
  var $cat = $row.find('select.input-category');
  if (src === 'category') {
    $cat.prop('disabled', false);
  } else {
    $cat.prop('disabled', true);
  }
}

$('#home-showcase-rows').on('change', 'select.input-source', function() {
  showcaseToggleCategory($(this).closest('tr'));
});

$('#btn-add-row').on('click', function() {
  var $src = $('#home-showcase-rows tr.home-showcase-row').first();
  var $row = $src.clone();
  $row.find('input[type=text]').val('');
  $row.find('input[type=number]').val('5');
  $row.find('input[type=checkbox]').prop('checked', true);
  $row.find('select.input-source').prop('selectedIndex', 0);
  $row.find('select.input-category').prop('selectedIndex', 0);
  $('#home-showcase-rows').append($row);
  showcaseReindexRows();
  showcaseToggleCategory($row);
});

$('#home-showcase-rows').on('click', '.btn-remove-row', function() {
  if ($('#home-showcase-rows tr.home-showcase-row').length < 2) {
    return;
  }
  $(this).closest('tr').remove();
  showcaseReindexRows();
});

$('#home-showcase-rows tr.home-showcase-row').each(function() {
  showcaseToggleCategory($(this));
});
//--></script></div>
{{ footer }}
