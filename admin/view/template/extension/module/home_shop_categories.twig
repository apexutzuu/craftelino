{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-heading">{{ entry_heading }}</label>
            <div class="col-sm-10">
              <input type="text" name="heading" value="{{ heading }}" placeholder="{{ placeholder_heading }}" id="input-heading" class="form-control" />
              <p class="help-block">{{ help_heading }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_see_all }}</label>
            <div class="col-sm-10">
              <label class="checkbox-inline">
                <input type="checkbox" name="see_all" value="1" {% if see_all %}checked="checked"{% endif %} /> {{ text_see_all_enable }}
              </label>
              <div style="margin-top:10px;">
                <input type="text" name="see_all_text" value="{{ see_all_text }}" placeholder="{{ placeholder_see_all_text }}" class="form-control" style="max-width:400px;margin-bottom:8px;" />
                <input type="text" name="see_all_href" value="{{ see_all_href }}" placeholder="{{ placeholder_see_all_href }}" class="form-control" style="max-width:600px;" />
                <p class="help-block">{{ help_see_all_href }}</p>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_categories }}</label>
            <div class="col-sm-10">
              <p class="help-block">{{ help_categories }}</p>
              <table class="table table-bordered" id="shop-cat-table">
                <thead>
                  <tr>
                    <td>{{ entry_category }}</td>
                    <td style="width:50px;"></td>
                  </tr>
                </thead>
                <tbody id="shop-cat-rows">
                  {% for row in category_rows %}
                  <tr class="shop-cat-row">
                    <td>
                      <select name="category_row[{{ loop.index0 }}][category_id]" class="form-control">
                        <option value="0">—</option>
                        {% for c in category_options %}
                        <option value="{{ c.category_id }}" {% if row.category_id == c.category_id %}selected="selected"{% endif %}>{{ c.name }}</option>
                        {% endfor %}
                      </select>
                    </td>
                    <td class="text-center">
                      <button type="button" class="btn btn-danger btn-xs btn-remove-cat-row"><i class="fa fa-minus-circle"></i></button>
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
              <button type="button" id="btn-add-cat-row" class="btn btn-default"><i class="fa fa-plus-circle"></i> {{ button_add_row }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
function shopCatReindex() {
  $('#shop-cat-rows tr.shop-cat-row').each(function(i) {
    $(this).find('select').attr('name', 'category_row[' + i + '][category_id]');
  });
}
$('#btn-add-cat-row').on('click', function() {
  var $row = $('#shop-cat-rows tr.shop-cat-row').first().clone();
  $row.find('select').prop('selectedIndex', 0);
  $('#shop-cat-rows').append($row);
  shopCatReindex();
});
$('#shop-cat-rows').on('click', '.btn-remove-cat-row', function() {
  if ($('#shop-cat-rows tr.shop-cat-row').length < 2) {
    $(this).closest('tr').find('select').prop('selectedIndex', 0);
    return;
  }
  $(this).closest('tr').remove();
  shopCatReindex();
});
//--></script></div>
{{ footer }}
