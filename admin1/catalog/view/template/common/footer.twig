</main>
<footer class="craft-footer">
  <div class="container">
    <div class="craft-footer-grid">
      <div>
        <div class="craft-footer-logo">CRAFT<span>ELINO</span></div>
        <p class="craft-footer-desc">Produse promoționale personalizate pentru firme din România. Calitate, termene respectate, suport la personalizare.</p>
      </div>
      <div class="craft-footer-col">
        <h4>Servicii</h4>
        <div class="craft-footer-company">
          <p class="craft-footer-company-name">{{ company.name }}</p>
          <p>CUI {{ company.cui }}</p>
          <p>Reg. com.: {{ company.reg }}</p>
          <p>{{ company.address }}</p>
          {% if procurement_email is defined and procurement_email %}
            <p><a href="mailto:{{ procurement_email }}">{{ procurement_email }}</a></p>
          {% endif %}
        </div>
        <ul class="craft-footer-services">
          {% for item in footer_services %}
            <li><span>{{ item }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="craft-footer-col">
        <h4>Cont</h4>
        <ul>
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="mailto:{{ procurement_email }}">Cerere ofertă B2B</a></li>
          <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
        </ul>
      </div>
      <div class="craft-footer-col">
        <h4>Ajutor</h4>
        <ul>
          {% for link in footer_help %}
            <li><a href="{{ link.href }}">{{ link.title }}</a></li>
          {% endfor %}
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
          <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
        </ul>
      </div>
    </div>
    <p class="craft-footer-trust" role="note">Livrare estimativă 5–7 zile lucrătoare · Plată online securizată · Drepturi conform legislației UE privind consumatorii.</p>
    <div class="craft-footer-bottom">
      <span>{{ powered }}</span>
      <div class="craft-pay-icons">
        <span>VISA</span>
        <span>MC</span>
        <span>PayPal</span>
        <span>OP</span>
      </div>
    </div>
  </div>
</footer>
</div>
{{ cookie }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body>
</html>
