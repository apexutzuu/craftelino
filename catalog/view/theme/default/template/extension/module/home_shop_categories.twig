<div class="row" style="margin-bottom:25px;">
  <div class="col-sm-12" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
    <h3>{{ heading }}</h3>
    {% if see_all_href %}
    <a href="{{ see_all_href }}">{{ see_all_text }}</a>
    {% endif %}
  </div>
  <div class="col-sm-12">
    {% for cat in categories %}
    <a href="{{ cat.href }}" class="btn btn-default" style="margin:4px;display:inline-block;">{{ cat.name }}</a>
    {% endfor %}
  </div>
</div>
