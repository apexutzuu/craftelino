{{ header }}
<div id="product-special" class="container" style="padding:0 20px;">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="section">
    <div class="section-header">
      <div class="section-title">{{ heading_title }}</div>
    </div>

    {{ content_top }}

    {% if products %}
    <div style="display:flex;align-items:center;justify-content:flex-end;margin-bottom:16px;gap:12px;">
      <div class="form-group input-group input-group-sm" style="margin:0;">
        <label class="input-group-addon" for="input-sort" style="background:#1a3a5c;color:#fff;border-color:#1a3a5c;">{{ text_sort }}</label>
        <select id="input-sort" class="form-control" onchange="location = this.value;" style="border:2px solid #e8e5df;">
          {% for sorts in sorts %}
          {% if sorts.value == '%s-%s'|format(sort, order) %}
          <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
          {% else %}
          <option value="{{ sorts.href }}">{{ sorts.text }}</option>
          {% endif %}
          {% endfor %}
        </select>
      </div>
      <div class="form-group input-group input-group-sm" style="margin:0;">
        <label class="input-group-addon" for="input-limit" style="background:#1a3a5c;color:#fff;border-color:#1a3a5c;">{{ text_limit }}</label>
        <select id="input-limit" class="form-control" onchange="location = this.value;" style="border:2px solid #e8e5df;">
          {% for limits in limits %}
          {% if limits.value == limit %}
          <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
          {% else %}
          <option value="{{ limits.href }}">{{ limits.text }}</option>
          {% endif %}
          {% endfor %}
        </select>
      </div>
    </div>

    <div class="prod-grid" style="grid-template-columns:repeat(4,1fr);">
      {% for product in products %}
      <div class="prod-card">
        <a href="{{ product.href }}" style="text-decoration:none;color:inherit;">
          <div class="prod-img">
            <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" style="max-width:80%;max-height:80%;object-fit:contain;" />
            {% if product.special %}
            <div class="prod-discount-badge">Ofertă</div>
            {% endif %}
            <button type="button" class="wishlist-btn" onclick="event.preventDefault();event.stopPropagation();wishlist.add('{{ product.product_id }}');"><i class="ti ti-heart"></i></button>
          </div>
          <div class="prod-body">
            <div class="prod-name">{{ product.name }}</div>
            <div class="prod-prices">
              {% if product.special %}
              <span class="prod-price-new">{{ product.special }}</span>
              <span class="prod-price-old">{{ product.price }}</span>
              {% elseif product.price %}
              <span class="prod-price-new">{{ product.price }}</span>
              {% endif %}
            </div>
            {% if product.rating %}
            <div style="margin-bottom:8px;">
              {% for i in 1..5 %}
              {% if product.rating < i %}
              <i class="ti ti-star" style="color:#ddd;font-size:14px;"></i>
              {% else %}
              <i class="ti ti-star-filled" style="color:#e8a020;font-size:14px;"></i>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </a>
        <div class="prod-body" style="padding-top:0;">
          <button type="button" class="add-cart-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="ti ti-shopping-cart"></i> Adaugă</button>
        </div>
      </div>
      {% endfor %}
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding:12px 0;">
      <div>{{ pagination }}</div>
      <div style="font-size:13px;color:#888;">{{ results }}</div>
    </div>
    {% else %}
    <div style="text-align:center;padding:40px;">
      <i class="ti ti-discount" style="font-size:60px;color:#ddd;display:block;margin-bottom:16px;"></i>
      <p style="font-size:16px;color:#888;">{{ text_empty }}</p>
      <a href="{{ continue }}" class="hero-cta" style="text-decoration:none;display:inline-flex;margin-top:16px;">{{ button_continue }}</a>
    </div>
    {% endif %}

    {{ content_bottom }}
  </div>
</div>
{{ footer }}
