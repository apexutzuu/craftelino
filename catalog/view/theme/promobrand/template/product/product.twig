{{ header }}
<div id="product-product" class="container" style="padding:0 20px;">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="product-info-promo">
    <!-- Product Gallery -->
    <div class="product-gallery">
      <div class="main-image">
        {% if thumb %}
        <a href="{{ popup }}" class="thumbnail" id="main-product-image">
          <img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" />
        </a>
        {% endif %}
      </div>
      {% if images %}
      <div class="thumb-list">
        {% if thumb %}
        <img src="{{ thumb }}" alt="{{ heading_title }}" class="active" data-popup="{{ popup }}" data-image="{{ thumb }}" />
        {% endif %}
        {% for image in images %}
        <img src="{{ image.thumb }}" alt="{{ heading_title }}" data-popup="{{ image.popup }}" data-image="{{ image.thumb }}" />
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <!-- Product Details -->
    <div class="product-details-promo">
      <div class="btn-group" style="margin-bottom:12px;">
        <button type="button" data-toggle="tooltip" class="btn btn-default" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><i class="ti ti-heart"></i></button>
        <button type="button" data-toggle="tooltip" class="btn btn-default" title="{{ button_compare }}" onclick="compare.add('{{ product_id }}');"><i class="ti ti-exchange"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <div class="product-meta">
        {% if manufacturer %}
        <span>Brand: <a href="{{ manufacturers }}">{{ manufacturer }}</a></span>
        {% endif %}
        <span>Cod: {{ model }}</span>
        <span>Stoc: {{ stock }}</span>
        {% if reward %}
        <span>Puncte: {{ reward }}</span>
        {% endif %}
      </div>

      {% if review_status %}
      <div class="rating" style="margin-bottom:16px;">
        <p>
          {% for i in 1..5 %}
          {% if rating < i %}
          <i class="ti ti-star" style="color:#ddd;font-size:18px;"></i>
          {% else %}
          <i class="ti ti-star-filled" style="color:#e8a020;font-size:18px;"></i>
          {% endif %}
          {% endfor %}
          <a href="" onclick="$('a[href=\'#tab-review\']').trigger('click'); return false;" style="margin-left:8px;color:#1a3a5c;">{{ reviews }}</a>
        </p>
      </div>
      {% endif %}

      {% if price %}
      <div class="product-price-box">
        {% if not special %}
        <span class="price-current">{{ price }}</span>
        {% else %}
        <span class="price-current">{{ special }}</span>
        <span class="price-old">{{ price }}</span>
        <span class="price-save">Economisești!</span>
        {% endif %}
        {% if tax %}
        <span style="font-size:12px;color:#888;margin-left:8px;">{{ text_tax }} {{ tax }}</span>
        {% endif %}
      </div>
      {% endif %}

      {% if points %}
      <p style="font-size:13px;color:#888;margin-bottom:12px;">{{ text_points }} {{ points }}</p>
      {% endif %}

      {% if discounts %}
      <div style="margin-bottom:16px;padding:12px;background:#f4f2ee;border-radius:8px;">
        <strong style="font-family:'Barlow Condensed',sans-serif;color:#1a3a5c;">Discount la volum:</strong>
        <ul style="margin:8px 0 0;padding-left:20px;">
          {% for discount in discounts %}
          <li style="font-size:13px;color:#555;">{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div id="product">
        {% if options %}
        <div style="margin-bottom:16px;">
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;color:#1a3a5c;margin-bottom:12px;">{{ text_option }}</h3>
          {% for option in options %}
          {% if option.type == 'select' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="form-control" style="border:2px solid #e8e5df;border-radius:8px;">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
              </option>
              {% endfor %}
            </select>
          </div>
          {% endif %}
          {% if option.type == 'radio' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label">{{ option.name }}</label>
            <div id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              <div class="radio">
                <label>
                  <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" />
                  {% if option_value.image %}<img src="{{ option_value.image }}" alt="{{ option_value.name }}" class="img-thumbnail" style="width:40px;height:40px;margin-right:8px;" />{% endif %}
                  {{ option_value.name }}
                  {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </label>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
          {% if option.type == 'checkbox' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label">{{ option.name }}</label>
            <div id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              <div class="checkbox">
                <label>
                  <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" />
                  {% if option_value.image %}<img src="{{ option_value.image }}" alt="{{ option_value.name }}" class="img-thumbnail" style="width:40px;height:40px;margin-right:8px;" />{% endif %}
                  {{ option_value.name }}
                  {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </label>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
          {% if option.type == 'text' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control" style="border:2px solid #e8e5df;border-radius:8px;" />
          </div>
          {% endif %}
          {% if option.type == 'textarea' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <textarea name="option[{{ option.product_option_id }}]" rows="5" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control" style="border:2px solid #e8e5df;border-radius:8px;">{{ option.value }}</textarea>
          </div>
          {% endif %}
          {% if option.type == 'file' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label">{{ option.name }}</label>
            <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="btn btn-default btn-block"><i class="ti ti-upload"></i> {{ button_upload }}</button>
            <input type="hidden" name="option[{{ option.product_option_id }}]" value="" id="input-option{{ option.product_option_id }}" />
          </div>
          {% endif %}
          {% if option.type == 'date' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="input-group date">
              <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD" id="input-option{{ option.product_option_id }}" class="form-control" />
              <span class="input-group-btn"><button class="btn btn-default" type="button"><i class="ti ti-calendar"></i></button></span>
            </div>
          </div>
          {% endif %}
          {% if option.type == 'datetime' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="input-group datetime">
              <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
              <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="ti ti-calendar"></i></button></span>
            </div>
          </div>
          {% endif %}
          {% if option.type == 'time' %}
          <div class="form-group{% if option.required %} required{% endif %}">
            <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="input-group time">
              <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
              <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="ti ti-calendar"></i></button></span>
            </div>
          </div>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        <!-- ============================================ -->
        <!-- DESIGN UPLOAD SECTION - Încarcă designul tău -->
        <!-- ============================================ -->
        <div class="design-upload-section">
          <h3><i class="ti ti-palette"></i> Încarcă designul tău</h3>
          <p style="font-size:13px;color:#666;margin-bottom:16px;">Ai deja un logo sau un design pregătit? Încarcă-l aici și noi îl vom aplica pe produs. Acceptăm fișiere PNG, JPG, PDF, AI, CDR, SVG.</p>
          
          <div class="design-upload-area" id="design-drop-zone">
            <i class="ti ti-cloud-upload"></i>
            <p>Trage fișierul aici sau <strong style="color:#e8a020;">click pentru a selecta</strong></p>
            <p class="upload-hint">Formate acceptate: PNG, JPG, PDF, AI, CDR, SVG (max. 10MB)</p>
          </div>
          <input type="file" id="design-file-input" name="design_file" accept=".png,.jpg,.jpeg,.pdf,.ai,.cdr,.svg" style="display:none;" />
          <input type="hidden" name="design_upload_code" id="design-upload-code" value="" />

          <div class="design-preview" id="design-preview" style="display:none;">
            <div style="display:flex;align-items:center;gap:12px;padding:12px;background:#f0f8f0;border-radius:8px;border:1px solid #2c5f2e;">
              <i class="ti ti-file-check" style="font-size:24px;color:#2c5f2e;"></i>
              <div>
                <div class="file-name" id="design-file-name"></div>
                <span class="remove-file" id="design-remove-file"><i class="ti ti-x"></i> Șterge fișierul</span>
              </div>
            </div>
          </div>

          <!-- Observații / Notes Section -->
          <div class="design-observations">
            <label><i class="ti ti-notes" style="margin-right:6px;"></i> Observații pentru personalizare</label>
            <textarea name="design_observations" id="design-observations" placeholder="Descrieți cum doriți să fie aplicat designul: poziție, dimensiune, culori, text suplimentar, etc. De exemplu: &quot;Logo centrat pe piept, dimensiune 10x8cm, culoare albă pe fundal închis.&quot;"></textarea>
            <p class="obs-hint"><i class="ti ti-info-circle"></i> Aceste observații ne ajută să personalizăm produsul exact cum doriți. Un designer va revizui cererea înainte de producție.</p>
          </div>
        </div>
        <!-- END DESIGN UPLOAD SECTION -->

        {% if recurrings %}
        <hr>
        <h3>{{ text_payment_recurring }}</h3>
        <div class="form-group required">
          <select name="recurring_id" class="form-control">
            <option value="">{{ text_select }}</option>
            {% for recurring in recurrings %}
            <option value="{{ recurring.recurring_id }}">{{ recurring.name }}</option>
            {% endfor %}
          </select>
          <div class="help-block" id="recurring-description"></div>
        </div>
        {% endif %}

        <div class="product-qty-row">
          <label for="input-quantity">{{ entry_qty }}</label>
          <div class="qty-control">
            <button type="button" id="qty-minus">−</button>
            <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" />
            <button type="button" id="qty-plus">+</button>
          </div>
          <input type="hidden" name="product_id" value="{{ product_id }}" />
        </div>

        {% if minimum > 1 %}
        <div class="alert alert-info" style="border-radius:8px;"><i class="ti ti-info-circle"></i> {{ text_minimum }}</div>
        {% endif %}

        <button type="button" id="button-cart" data-loading-text="{{ text_loading }}" class="btn-add-cart-big">
          <i class="ti ti-shopping-cart"></i> {{ button_cart }}
        </button>

        <button type="button" class="btn-wishlist-big" onclick="wishlist.add('{{ product_id }}');">
          <i class="ti ti-heart"></i> Adaugă la favorite
        </button>
      </div>
    </div>
  </div>

  <!-- Tabs: Description, Specifications, Reviews -->
  <div style="margin-top:24px;">
    <ul class="nav nav-tabs" style="border-bottom:2px solid #e8e5df;">
      <li class="active"><a href="#tab-description" data-toggle="tab" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:#1a3a5c;">{{ tab_description }}</a></li>
      {% if attribute_groups %}
      <li><a href="#tab-specification" data-toggle="tab" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:#1a3a5c;">{{ tab_attribute }}</a></li>
      {% endif %}
      {% if review_status %}
      <li><a href="#tab-review" data-toggle="tab" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:#1a3a5c;">{{ tab_review }}</a></li>
      {% endif %}
    </ul>
    <div class="tab-content" style="padding:20px 0;">
      <div class="tab-pane active" id="tab-description">{{ description }}</div>
      {% if attribute_groups %}
      <div class="tab-pane" id="tab-specification">
        <table class="table table-bordered" style="border-radius:8px;overflow:hidden;">
          {% for attribute_group in attribute_groups %}
          <thead>
            <tr><td colspan="2" style="background:#1a3a5c;color:#fff;font-family:'Barlow Condensed',sans-serif;font-weight:700;"><strong>{{ attribute_group.name }}</strong></td></tr>
          </thead>
          <tbody>
            {% for attribute in attribute_group.attribute %}
            <tr>
              <td style="font-weight:600;color:#1a3a5c;">{{ attribute.name }}</td>
              <td>{{ attribute.text }}</td>
            </tr>
            {% endfor %}
          </tbody>
          {% endfor %}
        </table>
      </div>
      {% endif %}
      {% if review_status %}
      <div class="tab-pane" id="tab-review">
        <form class="form-horizontal" id="form-review">
          <div id="review"></div>
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;color:#1a3a5c;margin-bottom:16px;">{{ text_write }}</h2>
          {% if review_guest %}
          <div class="form-group required">
            <div class="col-sm-12">
              <label class="control-label" for="input-name">{{ entry_name }}</label>
              <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" style="border:2px solid #e8e5df;border-radius:8px;" />
            </div>
          </div>
          <div class="form-group required">
            <div class="col-sm-12">
              <label class="control-label" for="input-review">{{ entry_review }}</label>
              <textarea name="text" rows="5" id="input-review" class="form-control" style="border:2px solid #e8e5df;border-radius:8px;"></textarea>
              <div class="help-block">{{ text_note }}</div>
            </div>
          </div>
          <div class="form-group required">
            <div class="col-sm-12">
              <label class="control-label">{{ entry_rating }}</label>
              &nbsp;&nbsp;&nbsp; {{ entry_bad }}&nbsp;
              <input type="radio" name="rating" value="1" /> &nbsp;
              <input type="radio" name="rating" value="2" /> &nbsp;
              <input type="radio" name="rating" value="3" /> &nbsp;
              <input type="radio" name="rating" value="4" /> &nbsp;
              <input type="radio" name="rating" value="5" />
              &nbsp;{{ entry_good }}
            </div>
          </div>
          {{ captcha }}
          <div class="buttons clearfix">
            <div class="pull-right">
              <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary" style="border-radius:8px;">{{ button_continue }}</button>
            </div>
          </div>
          {% else %}
          {{ text_login }}
          {% endif %}
        </form>
      </div>
      {% endif %}
    </div>
  </div>

  {% if products %}
  <div style="margin-top:24px;">
    <div class="section-header">
      <div class="section-title">Produse similare</div>
    </div>
    <div class="prod-grid">
      {% for product in products %}
      <div class="prod-card">
        <a href="{{ product.href }}" style="text-decoration:none;color:inherit;">
          <div class="prod-img">
            <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" style="max-width:80%;max-height:80%;object-fit:contain;" />
            {% if product.special %}
            <div class="prod-discount-badge">Ofertă</div>
            {% endif %}
            <button type="button" class="wishlist-btn" onclick="event.preventDefault();event.stopPropagation();wishlist.add('{{ product.product_id }}');" title="{{ button_wishlist }}"><i class="ti ti-heart"></i></button>
          </div>
          <div class="prod-body">
            {% if product.manufacturer %}
            <div class="prod-brand">{{ product.manufacturer }}</div>
            {% endif %}
            <div class="prod-name">{{ product.name }}</div>
            <div class="prod-prices">
              {% if product.special %}
              <span class="prod-price-new">{{ product.special }}</span>
              <span class="prod-price-old">{{ product.price }}</span>
              {% else %}
              <span class="prod-price-new">{{ product.price }}</span>
              {% endif %}
            </div>
          </div>
        </a>
        <div class="prod-body" style="padding-top:0;">
          <button type="button" class="add-cart-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="ti ti-shopping-cart"></i> Adaugă</button>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if tags %}
  <div style="margin-top:16px;padding:12px 0;">
    <span style="font-weight:600;color:#1a3a5c;">{{ text_tags }}</span>
    {% for i in 0..tags|length - 1 %}
    <a href="{{ tags[i].href }}" style="color:#e8a020;text-decoration:none;">{{ tags[i].tag }}</a>{% if i < (tags|length - 1) %}, {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {{ content_top }}
  {{ content_bottom }}
</div>

<!-- Design Upload JavaScript -->
<script type="text/javascript">
$(document).ready(function() {
  var dropZone = $('#design-drop-zone');
  var fileInput = $('#design-file-input');
  var preview = $('#design-preview');
  var fileName = $('#design-file-name');
  var removeBtn = $('#design-remove-file');
  var uploadCode = $('#design-upload-code');

  dropZone.on('click', function() {
    fileInput.trigger('click');
  });

  dropZone.on('dragover', function(e) {
    e.preventDefault();
    e.stopPropagation();
    $(this).css('border-color', '#e8a020').css('background', '#fff8ee');
  });

  dropZone.on('dragleave', function(e) {
    e.preventDefault();
    e.stopPropagation();
    $(this).css('border-color', '#ddd').css('background', '#fafaf8');
  });

  dropZone.on('drop', function(e) {
    e.preventDefault();
    e.stopPropagation();
    $(this).css('border-color', '#ddd').css('background', '#fafaf8');
    var files = e.originalEvent.dataTransfer.files;
    if (files.length > 0) {
      uploadDesignFile(files[0]);
    }
  });

  fileInput.on('change', function() {
    if (this.files.length > 0) {
      uploadDesignFile(this.files[0]);
    }
  });

  removeBtn.on('click', function() {
    fileInput.val('');
    uploadCode.val('');
    preview.hide();
    dropZone.show().removeClass('has-file');
  });

  function uploadDesignFile(file) {
    var formData = new FormData();
    formData.append('file', file);

    $.ajax({
      url: 'index.php?route=tool/upload',
      type: 'post',
      dataType: 'json',
      data: formData,
      cache: false,
      contentType: false,
      processData: false,
      beforeSend: function() {
        dropZone.html('<i class="ti ti-loader" style="font-size:40px;color:#e8a020;animation:spin 1s linear infinite;"></i><p>Se încarcă...</p>');
      },
      success: function(json) {
        if (json['error']) {
          dropZone.html('<i class="ti ti-cloud-upload"></i><p>Trage fișierul aici sau <strong style="color:#e8a020;">click pentru a selecta</strong></p><p class="upload-hint">Formate acceptate: PNG, JPG, PDF, AI, CDR, SVG (max. 10MB)</p>');
          alert(json['error']);
        }
        if (json['success']) {
          uploadCode.val(json['code']);
          fileName.text(file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)');
          dropZone.hide();
          preview.show();
        }
      },
      error: function(xhr, ajaxOptions, thrownError) {
        dropZone.html('<i class="ti ti-cloud-upload"></i><p>Trage fișierul aici sau <strong style="color:#e8a020;">click pentru a selecta</strong></p><p class="upload-hint">Formate acceptate: PNG, JPG, PDF, AI, CDR, SVG (max. 10MB)</p>');
        alert('Eroare la încărcare. Încercați din nou.');
      }
    });
  }

  // Quantity buttons
  $('#qty-minus').on('click', function() {
    var qty = parseInt($('#input-quantity').val()) || 1;
    if (qty > 1) {
      $('#input-quantity').val(qty - 1);
    }
  });
  $('#qty-plus').on('click', function() {
    var qty = parseInt($('#input-quantity').val()) || 1;
    $('#input-quantity').val(qty + 1);
  });

  // Thumbnail click
  $('.thumb-list img').on('click', function() {
    $('.thumb-list img').removeClass('active');
    $(this).addClass('active');
    $('#main-product-image img').attr('src', $(this).data('image'));
    $('#main-product-image').attr('href', $(this).data('popup'));
  });

  // MagnificPopup
  if ($.fn.magnificPopup) {
    $('#main-product-image').magnificPopup({ type: 'image' });
  }
});
</script>

<style>
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>

<!-- Standard OpenCart scripts for recurring, cart, upload, review -->
<script type="text/javascript">
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){
  $.ajax({
    url: 'index.php?route=product/product/getRecurringDescription',
    type: 'post',
    data: $('input[name=\'product_id\'], input[name=\'quantity\'], select[name=\'recurring_id\']'),
    dataType: 'json',
    beforeSend: function() { $('#recurring-description').html(''); },
    success: function(json) {
      $('.alert-dismissible, .text-danger').remove();
      if (json['success']) { $('#recurring-description').html(json['success']); }
    }
  });
});

$('#button-cart').on('click', function() {
  $.ajax({
    url: 'index.php?route=checkout/cart/add',
    type: 'post',
    data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea, #design-upload-code, #design-observations'),
    dataType: 'json',
    beforeSend: function() { $('#button-cart').button('loading'); },
    complete: function() { $('#button-cart').button('reset'); },
    success: function(json) {
      $('.alert-dismissible, .text-danger').remove();
      $('.form-group').removeClass('has-error');
      if (json['error']) {
        if (json['error']['option']) {
          for (i in json['error']['option']) {
            var element = $('#input-option' + i.replace('_', '-'));
            if (element.parent().hasClass('input-group')) {
              element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            } else {
              element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            }
          }
        }
        if (json['error']['recurring']) {
          $('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
        }
        $('.text-danger').parent().addClass('has-error');
      }
      if (json['success']) {
        $('.breadcrumb').after('<div class="alert alert-success alert-dismissible" style="margin:10px 0;border-radius:8px;">' + json['success'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        $('html, body').animate({ scrollTop: 0 }, 'slow');
        $('#cart > ul').load('index.php?route=common/cart/info ul li');
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});

$('.date').datetimepicker({ language: '{{ datepicker }}', pickTime: false });
$('.datetime').datetimepicker({ language: '{{ datepicker }}', pickDate: true, pickTime: true });
$('.time').datetimepicker({ language: '{{ datepicker }}', pickDate: false });

$('button[id^=\'button-upload\']').on('click', function() {
  var node = this;
  $('#form-upload').remove();
  $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');
  $('#form-upload input[name=\'file\']').trigger('click');
  if (typeof timer != 'undefined') { clearInterval(timer); }
  timer = setInterval(function() {
    if ($('#form-upload input[name=\'file\']').val() != '') {
      clearInterval(timer);
      $.ajax({
        url: 'index.php?route=tool/upload',
        type: 'post',
        dataType: 'json',
        data: new FormData($('#form-upload')[0]),
        cache: false,
        contentType: false,
        processData: false,
        beforeSend: function() { $(node).button('loading'); },
        complete: function() { $(node).button('reset'); },
        success: function(json) {
          $('.text-danger').remove();
          if (json['error']) { $(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>'); }
          if (json['success']) { alert(json['success']); $(node).parent().find('input').val(json['code']); }
        },
        error: function(xhr, ajaxOptions, thrownError) { alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText); }
      });
    }
  }, 500);
});

$('#review').delegate('.pagination a', 'click', function(e) {
  e.preventDefault();
  $('#review').fadeOut('slow');
  $('#review').load(this.href);
  $('#review').fadeIn('slow');
});

$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

$('#button-review').on('click', function() {
  $.ajax({
    url: 'index.php?route=product/product/write&product_id={{ product_id }}',
    type: 'post',
    dataType: 'json',
    data: $("#form-review").serialize(),
    beforeSend: function() { $('#button-review').button('loading'); },
    complete: function() { $('#button-review').button('reset'); },
    success: function(json) {
      $('.alert-dismissible').remove();
      if (json['error']) {
        $('#review').after('<div class="alert alert-danger alert-dismissible"><i class="ti ti-exclamation-circle"></i> ' + json['error'] + '</div>');
      }
      if (json['success']) {
        $('#review').after('<div class="alert alert-success alert-dismissible"><i class="ti ti-check"></i> ' + json['success'] + '</div>');
        $('input[name=\'name\']').val('');
        $('textarea[name=\'text\']').val('');
        $('input[name=\'rating\']:checked').prop('checked', false);
      }
    }
  });
});
