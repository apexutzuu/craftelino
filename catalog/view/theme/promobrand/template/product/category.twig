{{ header }}
<div id="product-category" class="container" style="padding:0 20px;">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {{ content_top }}

  <div class="section">
    <div class="section-header">
      <div class="section-title">{{ heading_title }}</div>
    </div>

    {% if thumb or description %}
    <div style="display:flex;gap:16px;align-items:flex-start;margin-bottom:20px;padding:16px;background:#fff;border-radius:10px;border:1.5px solid #e8e5df;">
      {% if thumb %}
      <img src="{{ thumb }}" alt="{{ heading_title }}" style="width:100px;border-radius:8px;" />
      {% endif %}
      {% if description %}
      <div style="font-size:14px;color:#555;line-height:1.6;">{{ description }}</div>
      {% endif %}
    </div>
    {% endif %}

    {% if categories %}
    <div style="margin-bottom:20px;">
      <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;color:#1a3a5c;margin-bottom:12px;">{{ text_refine }}</h3>
      <div class="cat-grid" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr));">
        {% for category in categories %}
        <a href="{{ category.href }}" class="cat-card" style="text-decoration:none;">
          <div class="cat-name">{{ category.name }}</div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if products %}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;padding:12px 16px;background:#fff;border-radius:8px;border:1.5px solid #e8e5df;">
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="btn-group btn-group-sm">
          <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="ti ti-list"></i></button>
          <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="ti ti-grid-dots"></i></button>
        </div>
        <a href="{{ compare }}" id="compare-total" class="btn btn-link" style="color:#1a3a5c;font-weight:600;">{{ text_compare }}</a>
      </div>
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="form-group input-group input-group-sm" style="margin:0;">
          <label class="input-group-addon" for="input-sort" style="background:#1a3a5c;color:#fff;border-color:#1a3a5c;">{{ text_sort }}</label>
          <select id="input-sort" class="form-control" onchange="location = this.value;" style="border:2px solid #e8e5df;">
            {% for sorts in sorts %}
            {% if sorts.value == '%s-%s'|format(sort, order) %}
            <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
            {% else %}
            <option value="{{ sorts.href }}">{{ sorts.text }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </div>
        <div class="form-group input-group input-group-sm" style="margin:0;">
          <label class="input-group-addon" for="input-limit" style="background:#1a3a5c;color:#fff;border-color:#1a3a5c;">{{ text_limit }}</label>
          <select id="input-limit" class="form-control" onchange="location = this.value;" style="border:2px solid #e8e5df;">
            {% for limits in limits %}
            {% if limits.value == limit %}
            <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
            {% else %}
            <option value="{{ limits.href }}">{{ limits.text }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </div>
      </div>
    </div>

    <div class="prod-grid" style="grid-template-columns:repeat(4,1fr);">
      {% for product in products %}
      <div class="prod-card">
        <a href="{{ product.href }}" style="text-decoration:none;color:inherit;">
          <div class="prod-img">
            <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" style="max-width:80%;max-height:80%;object-fit:contain;" />
            {% if product.special %}
            <div class="prod-discount-badge">Ofertă</div>
            {% endif %}
            <button type="button" class="wishlist-btn" onclick="event.preventDefault();event.stopPropagation();wishlist.add('{{ product.product_id }}');" title="{{ button_wishlist }}"><i class="ti ti-heart"></i></button>
          </div>
          <div class="prod-body">
            <div class="prod-name">{{ product.name }}</div>
            <div class="prod-prices">
              {% if product.special %}
              <span class="prod-price-new">{{ product.special }}</span>
              <span class="prod-price-old">{{ product.price }}</span>
              {% elseif product.price %}
              <span class="prod-price-new">{{ product.price }}</span>
              {% endif %}
            </div>
            {% if product.rating %}
            <div style="margin-bottom:8px;">
              {% for i in 1..5 %}
              {% if product.rating < i %}
              <i class="ti ti-star" style="color:#ddd;font-size:14px;"></i>
              {% else %}
              <i class="ti ti-star-filled" style="color:#e8a020;font-size:14px;"></i>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </a>
        <div class="prod-body" style="padding-top:0;">
          <button type="button" class="add-cart-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="ti ti-shopping-cart"></i> Adaugă</button>
        </div>
      </div>
      {% endfor %}
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding:12px 0;">
      <div>{{ pagination }}</div>
      <div style="font-size:13px;color:#888;">{{ results }}</div>
    </div>
    {% endif %}

    {% if not categories and not products %}
    <div style="text-align:center;padding:40px;">
      <i class="ti ti-package" style="font-size:60px;color:#ddd;display:block;margin-bottom:16px;"></i>
      <p style="font-size:16px;color:#888;">{{ text_empty }}</p>
      <a href="{{ continue }}" class="hero-cta" style="text-decoration:none;display:inline-flex;margin-top:16px;">{{ button_continue }}</a>
    </div>
    {% endif %}
  </div>

  {{ content_bottom }}
</div>
{{ footer }}
