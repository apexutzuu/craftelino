<!-- Countdown Timer Script -->
<script type="text/javascript">
var promoSecs = 11*3600 + 28*60 + 44;
var cdH = document.getElementById('cd-h');
var cdM = document.getElementById('cd-m');
var cdS = document.getElementById('cd-s');
function promoPad(n) { return n < 10 ? '0' + n : '' + n; }
function promoTick() {
  if (promoSecs <= 0) return;
  promoSecs--;
  cdH.textContent = promoPad(Math.floor(promoSecs / 3600));
  cdM.textContent = promoPad(Math.floor((promoSecs % 3600) / 60));
  cdS.textContent = promoPad(promoSecs % 60);
}
setInterval(promoTick, 1000);
</script>

